# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Runtime caches (transient — not results)
*.sqlite
*.db
*.tmp

# ChromaDB vector store — committed intentionally for Streamlit Cloud
# deployment (fresh clones have no local index to rebuild from).
# The generic *.sqlite3 rule above would otherwise block its internal
# database file, so it's explicitly re-included here.
*.sqlite3


# Uploaded images and local artifacts
uploads/
tmp/
*.log

plan md/